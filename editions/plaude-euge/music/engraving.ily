%% Engraving decisions for this score only (breaks, spacing).

%% Each half starts on its own system and page (principles 9.1), four
%% systems to a half. Part 1 is bars 1–19 (bar 14 is written into both
%% endings), part 2 bars 20–36. Systems end with the lines of the poem:
%% 'theotocos' (5), 'virginum' (9), 'confidencium' before the endings (13),
%% 'inspice' at the cadence on A (24), 'despice' on G (27), 'misericordie'
%% (30); the endings (14–19, 31–36) each take one system.
prBreaksCritical = #'(5 9 13 19 24 27 30)
prBreaksPerformance = #'(5 9 13 19 24 27 30)
