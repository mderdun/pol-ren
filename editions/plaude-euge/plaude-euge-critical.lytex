%% ================================================================ NOTES
\opensection{Critical notes}

\noindent Locations are given as bar, voice and note number, counting rests.
\voice{D} = Discantus, \voice{M} = Medius, \voice{T} = Tenor. \sig{R} reduces
the note values by four, bars in 2/4 with two bars of 3/4 (bars 6–8 here,
which need no change of metre in breve barring), and gives the Tenor no text.

\begin{apparatus}
\cn{1}{M 3}{\sig{MS} b, no accidental. Printed as b\fl{} by the signature, a
  fifth below the \voice{D} f′. \sig{R} and \sig{P} sing b\na{}, which makes
  the rise a–b–c′ smoother but forms a tritone with the \voice{D} f′. Compare
  20 \voice{M} 3.}
\cn{2}{D 2}{The minim stands almost as high as the g′ that follows it
  (3 \voice{D} 1). Read as f′, as in \sig{R}.}
\cn{2}{T 2}{\sig{MS} b, no accidental; b\fl{} by the signature, as in \sig{R}
  and \sig{P}. The note sounds against the \voice{D} e′ held from the previous
  beat, so either reading is dissonant. With b\fl{} it forms a tritone, with
  b\na{} a fourth above the lowest voice. The Tenor rises from a to b and
  falls to g, and the rule \textit{una nota super la semper est canendum fa}
  (a single note above la is sung as fa) favours the flat.}
\cn{6–10}{M}{Underlay: \textit{regina} is sung after the rests rather than
  divided by them, so the e at 6 \voice{M} 1 continues \textit{theotocos};
  \textit{-num} is held over two semibreves and \textit{salus} follows in
  bar 10. \sig{P} places the text the same way.}
\cn{10}{D}{Text: \sig{MS} \textit{salus}; \sig{R} prints \textit{sallus}.}
\cn{14–19}{}{\sig{MS} writes bar 14 once, before the repeat; here it is
  printed in both endings so that the Tenor can vary (see Editorial method).
  \voice{T} bars 14–19: the divided notes and the second-ending rhythm are
  editorial.}
\cn{15}{M 3–4}{\sig{MS} b–b, rising, where the second ending has a–a–g–g
  (18 \voice{M} 3–4). \sig{P} sings g–g in both endings. Here the Tenor has d,
  so g would form a fourth above it on the beat (d–g–f′); with b\fl{} the
  sonority is d–b\fl{}–f′. In the second ending the Tenor has b\fl{}, and g is
  a sixth above it.}
\cn{16, 19}{T}{The last note of each ending is a long in \sig{MS}, printed
  here as a long.}
\cn{18–19}{D}{Only the first three notes of this ending are clear in
  \sig{MS}. Note 4 is partly visible and the last note is hidden in the
  gutter. \sig{R} gives c′. This edition supplies e′. The Tenor's b\fl{}–a and
  the Medius's g–a make a cadence on A, and the Discantus then takes d′–e′, as
  it does in the first ending.}
\cn{19}{M 1}{\sig{MS} writes a long, placed between f and g. With \voice{T}
  b\fl{}–a, the cadence requires a (as \sig{R}).}
\cn{20}{M 3}{\na{} editorial (\sig{R} b\fl{}; \sig{P} b\na{}). The figure is
  the same as at 1 \voice{M} 3, but the counterpoint is not. Here the
  Discantus rises d′–e′–f′–g′ a fifth above the Medius g–a–b–c′, so b\fl{}
  would make four parallel fifths in a row; b\na{} breaks the chain with a
  diminished fifth on a passing minim. In bar 1 the Discantus moves
  differently (f′ held over a–b\fl{}, then e′) and no fifths arise, so the
  flat stands there.}
\cn{25}{M 1–4}{\sig{MS} writes these four notes as semibreves, without stems.
  As written, the Medius would run two semibreves longer than the other
  voices; read as minims, as in \sig{R}.}
\cn{29}{M 3}{This b\fl{} forms a fourth with the Tenor's f for a whole
  semibreve, the only such place in the piece. \sig{MS} and \sig{R} agree; it
  may be a copying error, but no simple emendation removes it.}
\cn{30}{M 2}{\na{} editorial, as in \sig{R}. With b\fl{} the note would form
  a tritone with the \voice{D} e′.}
\cn{31–36}{}{\sig{MS} writes the text of the second part in each upper voice
  as ‘… oculis hos respice’, then ‘hos respice’ after the double stroke. The
  text is not aligned with the notes, so the cue cannot be taken literally;
  the second ending has too few notes for the Discantus to sing \textit{oculis
  hos respice} there. The cadence on C at the start of the endings closes the
  phrase \textit{sed misericordie oculis,} so all voices sing \textit{-lis} on
  its first note and \textit{hos respice} after it, in both endings. \sig{R}
  has the same reading in the second ending.}
\cn{33, 36}{T}{The last note is a long in \sig{MS}, printed here as a long.}
\cn{35}{D 4, M 4}{\sh{} editorial in both voices (\sig{R} and \sig{P} have
  neither). In the final cadence the Tenor falls e–d under the Discantus
  c′–d′ and the Medius g–a. The rule that a sixth widening to an octave
  should be major calls for c\sh{}′; with it the Medius g must also be
  raised, or the upper voices form a tritone (e–g–c\sh{}′). Raising both gives
  the double leading-tone cadence common in the period. Leaving both natural,
  as \sig{R} and \sig{P} do, is the other consistent reading; c\sh{}′ with
  g\na{} is not.}
\cn{36}{D}{The last note is hidden in the gutter of \sig{MS} and is
  supplied.}
\end{apparatus}

