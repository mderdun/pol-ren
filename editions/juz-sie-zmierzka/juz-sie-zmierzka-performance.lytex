\section*{Text and translation}

\begin{textcols}
\stanzanumber{1} & \lines{\stanzaOne} & \lines{\transOne}\\[0.9em]
\stanzanumber{2} & \lines{\stanzaTwo} & \lines{\transTwo}\\[0.9em]
