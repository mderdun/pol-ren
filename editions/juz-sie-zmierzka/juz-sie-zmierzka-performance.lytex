\composer[c.\,1524 – c.\,1560]{Wacław z Szamotuł}
\title[Już się zmierzka]{Modlitwa gdy dziatki spać idą}
\subtitle{Już się zmierzka}
\poet{Andrzej Trzecieski}
\edition{First edition}{2026}
\headnote{An evening prayer for the household, Kraków, early 1550s.
  The Tenor sings the hymn tune; the other voices keep it company.}

