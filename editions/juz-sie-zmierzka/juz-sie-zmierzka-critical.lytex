\opensection{Critical notes}\label{s:notes}

\noindent PWM, K and M transpose up a minor third, halve the values, bar in
4/4 and use a signature of three flats. Their readings are given here at the
pitch and in the values of this edition. Bar numbers agree in all four.

\begin{apparatus}
\cn{1–2}{A}{PWM splits the dotted minim f′ so that ‘się’ has a note of its
  own. A has one dotted minim; ‘się’ falls on the following e′.}
\cn{4}{C}{PWM raises the semiminim g′ as well as the cadential minim. Only the
  minim is raised here, as in K and M.}
\cn{8–10}{A, T}{M exchanges the two parts, ‘for tessitura’. A has the
  semiminims c′ b a g and the descent f e d in the Altus.}
\cn{8–9}{A}{PWM, K: ‘ga’ on the semiminim c′, ‘o’ on f. Here ‘ga’ on f and
  ‘o’ on e, so that ‘pomoc’ falls with the Cantus and Tenor.}
\cn{12–13}{C, B}{Parallel fifths d′–g′ over g–c. They stand in A.}
\cn{15–17}{C}{PWM, K, M: ‘złych’ on the semiminim g′, bar 17. Here on a′,
  bar 16, in step with the Altus.}
\cn{23}{A}{K, M: ‘-cej’ on the second semiminim a. Here on b, straight after
  the dotted minim.}
\cn{27–29}{C}{PWM, K, M put ‘ją’ on the e′ of bar 27. Here ‘ją’ c′, ‘swej’ d′,
  ‘chy-’ e′, ‘-tro-’ d′. A leaves a gap after ‘Vżywá’, which keeps the e′
  within the melisma; the line then moves with Tenor and Bassus.}
\cn{28}{A}{M: ‘ją’ on the second semiminim c′. Here on d′, straight after the
  dotted minim.}
\cn{29}{A}{PWM, K and M flatten b (\la{una nota super la}). Left as in A:
  b\fl\ would sound a tritone against e′ in the Cantus, and b is the sixth
  degree of the D mode. Singers who prefer the flat may take it.
  \verdict{A kept.}}
\cn{30}{B}{A has a maxima, given as a longa to match the other voices.}
\cn{text}{}{PWM: ‘zmierzcha’, ‘naszym stróżem’. K, M: ‘naszym strażem’;
  M ‘zmierzcha’. All three print ‘On’ with a capital. A: ‘zmyerzka’,
  ‘nássem strażem’, ‘nawyęcey’, ‘on’.}
\end{apparatus}

