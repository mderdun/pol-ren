%% ================================================================ NOTES
\opensection{Critical notes}

\noindent \sig{PWM}, \sig{K} and \sig{M} transpose up a minor third, halve the values, bar in
4/4 and use a signature of three flats. Their readings are given here at the
pitch and in the values of this edition. Bar numbers agree in all four.

\begin{apparatus}
\cn{1–2}{A}{\sig{PWM} splits the dotted minim f′ so that ‘się’ has a note of its
  own. \sig{A} has one dotted minim; ‘się’ falls on the following e′.}
\cn{4}{C}{\sig{PWM} raises the semiminim g′ as well as the cadential minim; \sig{K} and
  \sig{M} raise the minim only. Here the minim is raised and the semiminim,
  a lower neighbour to a′, has an optional sharp.}
\cn{8–10}{A, T}{\sig{M} exchanges the two parts, ‘for tessitura’. \sig{A} has the
  semiminims c′ b a g and the descent f e d in the Altus.}
\cn{8–9}{A}{\sig{PWM}, \sig{K}: ‘ga’ on the semiminim c′, ‘o’ on f. Here ‘ga’ on f and
  ‘o’ on e, so that ‘pomoc’ falls with the Cantus and Tenor.}
\cn{12–13}{C, B}{Parallel fifths d′–g′ over g–c. They stand in \sig{A}.}
\cn{15–17}{C}{\sig{PWM}, \sig{K}, \sig{M}: ‘złych’ on the semiminim g′, bar 17. Here on c″,
  bar 16, the semiminim straight after the dotted minim of ‘od’. ‘Czar-’ takes
  the leap c′–c″ and the run down from it, and ‘-tów’ the dotted minim e′ and
  the semiminim after it, so that ‘nas o-bro-’ falls on g′ a′ g\sh′ as ‘chy-tro-’
  does at the final cadence. In stanza 2 ‘wiecz-’ takes c′, ‘-ny’ the run, and
  ‘spra-’ the semibreve a′.}
\cn{19}{C}{g′ left as printed: the minor sixth b–g′ gives a softer close at
  the middle of the stanza than the raised cadences around it.}
\cn{23}{A}{\sig{K}, \sig{M}: ‘-cej’ on the second semiminim a. Here on b, straight after
  the dotted minim.}
\cn{27–29}{C}{\sig{PWM}, \sig{K}, \sig{M} put ‘ją’ on the e′ of bar 27. Here ‘ją’ c′ and
  ‘swej’ d′, bar 28, each with the minim after it; ‘chy-’ the semibreve d′ and
  ‘-tro-’ c\sh′, a minim after the other voices. \sig{A} leaves a gap after ‘Vżywá’,
  which keeps the e′ of bar 27 within the melisma. Stanza 2: ‘na-’ c′, ‘-sze’
  d′, ‘wo-’ e′ and the semibreve d′, ‘-ła-’ c\sh′.}
\cn{28}{A}{\sig{M}: ‘ją’ on the second semiminim c′. Here on d′, straight after the
  dotted minim.}
\cn{29}{A}{\sig{PWM}, \sig{K} and \sig{M} flatten b (\la{una nota super la}). Left as in \sig{A}:
  b\fl\ would sound a tritone against e′ in the Cantus, and b is the sixth
  degree of the D mode. The flat is printed in brackets as an option.
  \verdict{A kept.}}
\cn{30}{B}{\sig{A} has a maxima, given as a longa to match the other voices.}
\cn{text}{}{\sig{PWM}: ‘zmierzcha’, ‘naszym stróżem’. \sig{K}, \sig{M}: ‘naszym strażem’;
  \sig{M} ‘zmierzcha’. All three print ‘On’ with a capital. \sig{A}: ‘zmyerzka’,
  ‘nássem strażem’, ‘nawyęcey’, ‘on’.}
\end{apparatus}

