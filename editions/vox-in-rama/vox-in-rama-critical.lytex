%% ================================================================ NOTES
\opensection{Critical notes}

\noindent Bar numbers refer to this edition, one breve to the bar. Pitches are
given at this edition’s pitch, with c′ as middle C. Voices: \voice{C},
\voice{A}, \voice{T}, \voice{B}. Readings of \sig{N} and \sig{M} are quoted at this pitch.

\begin{apparatus}
\cn{5–6}{A}{Underlay. \sig{M} sets ‘Ra-ma’ on c″–b′ and then a melisma of eight
  notes on ‘-ma’. \sig{N} sets ‘Ra-ma, in Ra-ma’: ‘in’ on a′ (bar 5), ‘Ra-’ on
  g\sh′, ‘-ma’ on a′ (bar 6). \sig{N} is followed. Its melisma falls on the
  stressed syllable, and the Altus then says ‘vox in Rama, in Rama’ as the
  Cantus (bars 4–7) and Tenor (bars 3–9) do.}
\cn{6}{T}{Underlay. As \sig{M}: ‘in’ on e′, ‘Ra-’ on the semiminim a, the first
  of the run, on the minim beat (principles 10.1(a)); the run keeps it. The
  Tenor sings ‘vox in Rama, in Rama’ as the Cantus and Altus do.}
\cn{8}{T}{Fusae g\sh′ f\sh′: \sig{T} without sharps; the minim g\sh′ that follows
  has its sharp in \sig{T}. \sig{N} and \sig{M} sharpen all three.}
\cn{11–13}{A}{Underlay. \sig{M}: ‘au-di-ta est’ twice, with ‘au’, ‘di’ and ‘ta’ on
  semiminims. The Altus begins each statement with the Cantus and moves in
  and out of its rhythm, so both are kept, with \la{est}. The first stands as
  in \sig{M}: ‘au-’ on the semiminim c″, which the next note repeats
  (principles 10.1(b)), ‘-di-’ c″ with the fusae, ‘-ta’ b′ straight after
  them, at the phrase end (10.1(d)), ‘est’ c″. The second is also as
  \sig{M}: ‘au-’ e″, ‘-di-’ on the semiminim d″ under the Cantus’s ‘-di-’
  and through the c″, ‘-ta’ on the semiminim b′, ‘est’ c″ (bar 13). This
  is an editorial departure from principles 10.1: a syllable on a lone
  semiminim is none of its licences, and ‘-di-’ does not pass a syllable
  to the next note. It is kept for singability. ‘-di-’ takes the falling
  d″–c″, so that the line does not break into ‘au-di-ta-a est’ on two
  separate vowel onsets. The reading chooses lyrical flow over the
  play against the tactus, which Zieleński only hints at here; the
  disorder comes with ‘ploratus et ululatus’ and the homorhythm of
  ‘Rachel plorans’ (bars 23–27). (MD, 5 October 2026)}
\cn{15}{T}{e′–d′ in ligature, e′ without flat in \sig{T}. \sig{N} and \sig{M} have
  e\fl′. With e\na′ the Tenor sounds a sixth below c″ and then a fifth below
  b′; with e\fl′ it forms a minor 6/3 and then the augmented triad
  e\fl′–g′–b′. The flat is not in the print, and the counterpoint argues
  against it. It may come from the \la{Partitura} or from the parent edition.
  The real chromatic moment comes two minims later, when the Cantus b\fl′
  meets the Altus f\sh′ over the Tenor d′.}
\cn{17–18}{A}{Emended. \sig{N} and \sig{M} have a–c′–d′–e′ an octave lower, the last
  four notes of the melisma on ‘-tus’. They take the Altus to a, a fourth
  below any other note in the part, and then make it leap e′–e″ to
  ‘ploratus’. In the high clefs of this piece an Altus would hardly go below
  d′. Raised an octave, the line runs a′–c″–d″–e″ into the repeated e″ of
  ‘ploratus’, crosses no other voice, and makes no parallels. The error is
  common to \sig{N} and \sig{M}, so it goes back to their parent. How it
  arose cannot be shown while the Altus partbook is lost; an octave slip in
  transcription is the simplest cause. The \la{Partitura} should settle it.}
\cn{17}{T}{b–a in ligature, the second note black. In imperfect time a black
  semibreve followed by short notes is worth a dotted minim, which is the
  value \sig{N} and \sig{M} give it.}
\cn{17–19}{B}{Underlay. As \sig{M}, one syllable to a note: ‘et’ f, ‘u-’ e,
  ‘-lu-’ e, ‘-la-’ d, ‘-tus’ a. The stressed ‘-la-’ (\la{ululātus}) has the
  d at the half-bar, and the Bassus answers the Cantus’s ‘ploratus et
  ululatus’ (bars 17–20) word for word (principles 10.10).}
\cn{27}{B}{Underlay. As \sig{M}: ‘su-’ on the semiminim d, the first of the
  run, on the minim beat (principles 10.1(a)); the run and the semibreve a
  keep it. The Bassus then changes syllable with the other voices in the
  homorhythm of bars 23–27, and ‘-os’ of ‘filios’ does not pass s–s into
  ‘su-’ on the last fusa of a run (principles 10.6).}
\cn{25, 31}{T}{The figure c\sh′–b–c′–d′ at the cadence: \sig{T} prints the sharp on
  the fusa and not on the minim. The minim’s sharp is editorial. \sig{N} and \sig{M}
  have it before the note.}
\cn{31–33}{A}{Underlay. As \sig{M}: ‘et no-lu-it’ on d′ g′ g′ f\sh′, syllabic
  as the head of the imitation is in every voice (principles 10.10), so that
  ‘no-’ has the downbeat; then ‘con-’ on the semiminim g′, the first of the
  run, on the minim beat (principles 10.1(a)). The run and the a′ after it
  keep ‘con-’; ‘-so-la-ri’ follows on g′ e′ a′.}
\cn{35–37}{T}{Underlay. \sig{T} gives these bars by \textit{ij}. As \sig{M}: ‘et
  no-lu-it con-so-la-ri’, with ‘con-’ g′, ‘-so-’ e′, ‘-la-’ on the semiminim
  d′, the first of the run, on the minim beat (principles 10.1(a)), and
  ‘-ri’ on b straight after the run. Between the statements of ‘et noluit’
  at bars 35 and 37, each kept syllabic (principles 10.10), no other note
  can take ‘-ri’, and it ends the phrase (10.1(d)).}
\cn{36–37}{A}{Underlay. \sig{M}: ‘-so-’ on the semiminim c″ after the dotted
  minim d″, ‘-la-’ b′. Here ‘con-’ keeps c″ and ‘-so-’ takes b′, so that the
  stressed ‘-la-’ comes on the c″ of the downbeat (bar 37); ‘-ri’ b′ after
  the run, at the phrase end (principles 10.1(d)).}
\cn{38–39}{C}{Underlay. \sig{M}: ‘-so-’ on the semiminim d″, ‘-la-’ c″. Here ‘con-’
  keeps d″ and ‘-so-’ takes c″, so that the stressed ‘-la-’ comes on the b′
  of the weak cadence and ‘-ri’ on c″ (bar 40).}
\cn{38–39}{T}{Underlay. \sig{M}: ‘et no-lu-it (melisma) con- (melisma)
  so-la-ri’. \sig{N}: ‘no-lu-it, no-lu-it con-so-la-ri’, filling the melisma
  with another ‘noluit’. \sig{T} has ‘\& no-’ at the end of its fifth staff and
  ‘luit conso la ri’ at the start of the sixth, one statement only, so \sig{N}’s
  extra ‘noluit’ is not in the print. \sig{M}’s ‘et’ is kept, at the head of
  the imitation (bar 37); its ‘con-’ moves forward to c′ (bars 38–40).}
\cn{38–40}{T}{Underlay. \sig{M}: ‘con-’ g a b, ‘-so-’ e′, ‘-la-’ on the repeated
  semiminim e′, ‘-ri’ a. Here ‘con-’ c′ and ‘-so-’ g a b e′, so that the
  stressed ‘-la-’ keeps \sig{M}’s e′ at the downbeat of bar 40: the first
  of the run, on a pitch repeated after a minim (principles 10.1(a), (b)).
  ‘-ri’ a follows the run at the phrase end (10.1(d)).}
\cn{42}{C}{e″ on the second minim against the Bassus f, both newly struck: a
  passing semiminim on the beat. \sig{N} and \sig{M} agree.}
\cn{45}{}{\sig{T} ends on a longa a′, followed by the final bar line. \sig{N} and \sig{M}
  give breves. The other voices are given longae to match.}
\end{apparatus}

\section*{Literature}

\begin{literature}
\lit Chemotti, Antonio. Review of \textit{Italian Music in Central-Eastern
  Europe}, ed. Jeż, Przybyszewska-Jarmińska and Toffetti. \textit{Muzyka} 62,
  no.\,3 (2017): 130–37.
\lit Johnstone, Andrew. ‘“High” Clefs in Composition and Performance.’
  \textit{Early Music} 34, no.\,1 (2006): 29–53. Appendix 1b quotes
  Banchieri, \textit{Cartella} (2nd edn, Venice, 1610), pp.\,13–15; appendix
  1c, Picerli, \textit{Specchio secondo di musica} (Naples, 1631), p.\,192.
