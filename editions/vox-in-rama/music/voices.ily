tenorNotes = { r\longa r1 a'1. e'2 g'1. f'2 e'1. e'2 a4 b4 c'4 d'4 e'4 fis'4 g'1 g4 a4 b4 c'4 d'4 a'2 \fi gis'8 \fi fis'8 gis'2 a'2 f'2 e'2 a'2 d'2 g'2. f'4 d'2 c'2 r4 e'4 f'2 g'2 c'1 r\breve r2 g'2 f'1 f'2 e'2 \[ e'1 d'1\] d'2. c'8 b8 a4 b4 c'2 \[ b1 a2.\colNote\] g8 a8 b2 cis'2 d'1 r2 a'1 g'2 f'1 e'1. a2 b1 c'1 d'1. a'1 g'2 f'2 e'2 d'2 b2. b4 d'2. cis'8 b8 \fi cis'2 d'2 d'2. d'4 e'2 \[ f'1 e'1\] d'2 a2 d'2. d'4 cis'2 d'2. e'4 f'4 d'4 e'2 d'1 d'2. cis'8 b8 \fi cis'2 d'1 r\breve g2 d'2. d'4 cis'2 d'2 d'2 e'1 d'2 r1 c'2 g'2. g'4 fis'2 g'2 e'2 d'4 c'4 b2 c'2 a2. a4 b2 c'2 g2 a2 b2 e'2 e'4 d'4 c'4 b4 a2 e'1 f'2 f'2. g'4 a'1. a'2 f'1. d'2 f'2. g'4 a'1 a'\longa*1/2 \bar "|." }
