%% Vox in Rama — Mikołaj Zieleński
%% Voice data at the written pitch of the 1611 Tenor (final A, no signature)
%% and in its note values. Absolute pitch, c' = middle C.
%% Tenor from the print (T); Cantus, Altus and Bassus from Marchesano (M),
%% transposed up a major third and with values doubled.
%% Generated by build_voices.py and build_lyrics.py from src_M_Marchesano.xml,
%% with the readings of T and the emendations listed in build_voices.py.
%% \fi = editorial accidental (above the note); \[ \] = ligature of T;
%% \colNote = blackened note of T. Final longae are scaled to the length of the
%% last bar, so that the voices end together.

% underlay: ok U301 bar 28 'suos' -- MD: the Cantus resolves melodically on the a', not the d''; it and the Bassus carry the phrase across the join, so -os is held for momentum (10.6)
% underlay: ok U206 bar 34 'consolari' -- MD: con- (open, sonorant close) can carry the run; so- earlier would pass o-n-s across a fusa, and -la- is pinned to the strong 35.3 (10.6)
cantusNotes = { e''1. a'2 c''1 b'1 r\breve e''1. b'2 d''1 d''2 c''2 b'1 a'2. b'4 c''2 b'4 a'4 b'1 r1. e''1 a'2 c''1 b'2 c''2. b'8 a'8 b'2 c''2 e''2 d''2 d''2 e''2 g''2 f''2 d''2 e''2 e''2 d''1 d''2 c''2 c''1. b'2 bes'1 a'\breve r1. a''2 g''1 fis''2 f''2 e''1 d''2 e''2. d''8 c''8 d''2 e''1 r1. d''1 c''1 bes'2 a'2 f''1 e''2 d''2 c''2 b'2 d''2. d''4 d''2 e''1 a'2 f''2. f''4 e''1 d''2. cis''8 b'8 cis''4 b'8 cis''8 d''1 a'1 r2 a'2 d''2. d''4 cis''2 d''2. e''4 f''4 d''4 e''2 e''2 d''1 d''1 r1. d''2 g''2. g''4 fis''2 g''2. f''4 e''4 d''8 c''8 d''2 e''2 e''2 d''4 c''4 d''4 c''4 b'4 a'8 g'8 a'2 r\breve e''2 a''2. a''4 g''2 e''2. d''4 c''2 b'1 c''2 e''1 c''2 c''1 a'2 f''1 e''4 d''4 c''4 d''4 e''1 d''4 cis''4 d''4 a'4 a''2. g''4 f''4 e''4 f''1 e''\longa*1/2 \bar "|." }
altusNotes = { r\longa e''1. a'2 c''1 b'1. a'2 gis'2 a'2. gis'8 fis'8 gis'2 a'1 r1. d''1 a'2 c''2 b'2 c''2. d''4 e''4 c''4 f''2. e''4 e''4 d''8 c''8 d''2 d''2 e''2 c''4 c''2 b'8 a'8 b'2 c''2 e''2 d''4 c''2 b'4 c''2 c''2 b'1 a'1. g'2 g'1 fis'2 g'1 f'1 e'4 d'4 e'2 d'2. a'4 c''4 d''4 e''2 e''2 a'2 d''1 c''2 b'2 b'2 a'2. b'4 c''2 b'4 a'4 b'2 a'2 r2 g'1 fis'2 g'1 a'2 d''1 c''2 a'1 g'2 g'2. g'4 a'2 g'1 f'2 a'2. a'4 a'2 a'\breve f'2 d'2 f'2. f'4 e'2 f'2. g'4 a'4 f'4 g'2 f'2 a'1 a'1 r2 d'2 g'2. g'4 fis'2 g'4 a'4 bes'4 g'4 a'2 g'2 e'2 a'2 r\breve g'2 c''2. c''4 b'2 d''2. c''4 b'2 c''2 b'4 a'4 b'2 a'2 c''2 d''2 e''2 c''2. b'4 a'2. gis'8 fis'8 gis'2 a'2 c''1 a'2 a'1 a'2 d''1 c''4 b'4 a'4 b'4 c''2 a'1. f''2. e''4 d''4 cis''4 d''4 a'4 d''1 cis''4 b'4 cis''\longa*1/4 \bar "|." }
