%% Editorial suggestion, performance edition only (principles 2.3): at the
%% final, when the Altus reaches its last note, Tenor and Bassus may drop to
%% the lower octave. Small notes in square brackets.
tenorSugg  = { s\breve*44 s1 \suggFinal a1 }
bassusSugg = { s\breve*44 s1 \suggFinal a,1 }
