%% ================================================================ NOTES
\opensection{Critical notes}

\section*{Readings of \sig{T} altered in \sig{P}}

References are to bar, voice and note; tied continuations are not counted.
Pitches are at the pitch of this edition (c′ = middle C), and note values
are those of this edition, twice those of \sig{T} and \sig{P}. Each note
gives \sig{T}’s reading, Perz’s change and his reason, then this edition’s
decision in small capitals.

Perz’s changes fall into three groups. Some cure a fault of counterpoint,
such as parallel octaves, a mishandled dissonance or an inner voice given to
the wrong part. These are \verdict{accepted}, because restoring \sig{T}
brings the fault back. Others remove a figure Perz thought instrumental. He
judged it at the halved values of the tablature. At this edition’s values
the figures are ordinary vocal ornaments, so \sig{T} is \verdict{restored}
unless it creates a fault. The last group joins repeated notes ‘for the
underlay’. \sig{T} is restored where its repeated notes can carry syllables,
as Stoquerus requires, and \sig{P} stands where they cannot.

\begin{apparatus}
\cn{6}{C}{\sig{T}: e′ tied from bar 5, e′ (minims), f′ d′ (semiminims), e′
  (minim). \sig{P}: tied breve e′ and breve rest, the figure being
  instrumental. At doubled values it is a common cadential ornament, and
  makes no fault. \verdict{T restored} (\la{ve-re} repeated).}
\cn{9}{T}{\sig{T}: in the second half, minim c′ and semibreve c′ tied into
  bar 10. \sig{P}: dotted semibreve, for the underlay. The repeated c′ takes
  \la{-o}. \verdict{T restored.}}
\cn{20}{A}{\sig{T}: in the second half, minim f′ and semibreve f′ tied into
  bar 21. \sig{P}: dotted semibreve, for the underlay. \sig{T} would give
  five repeated f′ to the four syllables of \la{-lum an-ge-lum}.
  \verdict{P accepted.}}
\cn{25}{A, T}{\sig{T}: \voice{A} c′, \voice{T} g. \sig{P} exchanges them,
  to avoid octaves and fifths with \voice{B}. \sig{T} gives octaves
  \voice{A}–\voice{B} twice and fifths \voice{T}–\voice{B}. \verdict{P
  accepted.}}
\cn{26}{A}{\sig{T}: e′ in place of the rest. Omitted in \sig{P} for octaves
  with \voice{B}. The octave is approached, not consecutive; but the rest
  lets the Altus breathe before its entry at \la{et eripuit}, and the e′ is
  probably the organist’s filling. \verdict{P accepted.}}
\cn{30}{A}{\sig{T}: first note e′. \sig{P}: c′, for the cadence the text
  creates. \sig{T}’s e′ supplies the only third of the C chord, which
  otherwise stands bare for a semibreve. \verdict{T restored.}}
\cn{31}{A, T}{\sig{T}: \voice{A} c′, \voice{T} a. \sig{P} exchanges them,
  restoring the tenor’s line. \verdict{P accepted.}}
\cn{34}{A}{\sig{T}: second note a. \sig{P}: b, for the cadence. The cadence
  to C has the 4–3 suspension in the Cantus, and b is its leading note.
  \verdict{P accepted.}}
\cn{35–37}{C}{\sig{T}: two separate breves f′. \sig{P} ties them, for the
  underlay. The second f′ falls after the clause has ended, and no syllable
  is left for it. \verdict{P accepted.}}
\cn{37}{A}{\sig{T}: the first two notes are one dotted semibreve d′.
  \sig{P} divides it (semibreve, minim) to keep the imitation exact.
  \verdict{P accepted} (rule 5).}
\cn{49–50}{C}{\sig{T}: minims g′ e′ in place of the tied semibreve g′.
  \sig{P}: g′, for octaves with \voice{T}. The octaves are real.
  \verdict{P accepted.}}
\cn{49}{B}{\sig{T}: second note without rhythm sign; read as a minim.}
\cn{52}{C}{\sig{T}: in the second half, semiminims d′ c′ d′ e′. \sig{P}:
  dotted minim d′, semiminim e′ (instrumental figure; fifths with
  \voice{T}). The figure is vocal at these values, but the fifths are real
  (\voice{C}–\voice{T}, bar 52). \verdict{P accepted.}}
\cn{53}{T}{\sig{T}: first note f. \sig{P}: a, for octaves with \voice{C}.
  The octaves are real. \verdict{P accepted.}}
\cn{64}{T}{\sig{T}: third note d. \sig{P}: f, calling d an error. d would be
  a dissonant semiminim left by leap. \verdict{P accepted.}}
\cn{71}{A, T}{\sig{T}: \voice{A} c′, \voice{T} a. \sig{P} exchanges them
  (imitation in \voice{A}; octaves between \voice{T} and \voice{B}). The
  octaves are real. \verdict{P accepted.}}
\cn{76–77}{A}{\sig{T}: one breve e′ in each bar. \sig{P}: two semibreves
  each, for the underlay. The split gives \la{et nunc, et semper} in the
  declamation the other voices have. \verdict{P accepted.}}
\cn{81}{T}{\sig{T}: third note b. \sig{P}: g, for the cadence. \sig{T}’s b
  sounds the resolution against the Cantus’s suspended c″. \verdict{P
  accepted.}}
\cn{81–83}{C}{\sig{T}: minims c″ a′ b′ g′ f′ a′, semibreves b′ c″, minims
  c″ a′. \sig{P}: dotted semibreve c″, minim b′, semibreves a′ b′, dotted
  semibreve c″; \sig{P} calls the sequence instrumental. At these values it
  is a vocal sequence in minims, consonant throughout, without parallels.
  \verdict{T restored} (\la{saeculorum} twice).}
\cn{86}{C}{\sig{T}: two minims in place of the semibreve a′. \sig{P} joins
  them, for the underlay. \sig{T} would put the final syllable before the
  cadence. \verdict{P accepted.}}
\cn{86}{B}{\sig{T}: second note d. \sig{P}: f, for octaves with \voice{A}.
  The octaves are real. \verdict{P accepted.}}
\end{apparatus}

\section*{Other notes}

\begin{apparatus}
\cn{15–16}{C, T}{Parallel fifths (b′ e′ to a′ d′, bar 16), left as in
  \sig{T}, following \sig{P}.}
\cn{44}{C}{b′ as in \sig{T}, a tritone above the bass F on the third minim;
  \sig{P} does not alter it. b\fl′, as in bar 45, is printed in brackets as an option.}
\cn{44}{B}{The flat is \sig{P}’s; \sig{T} has B, against b\fl\ in the Tenor
  a minim later.}
\cn{54}{A, T}{Parallel fifths on the first minim, as in \sig{P}.}
\cn{56}{A}{e′ (small note) is \sig{P}’s addition, in square brackets in
  \sig{P}; \sig{T} presumably continued c′ from bar 55. \sig{P}’s e′ makes
  fifths with \voice{B} (a–e′, E–b); the tied c′ does not, and is a fair
  alternative.}
\cn{57–62}{B, T}{Bassus rests for six bars, Tenor for three; the \la{Gloria
  Patri} opens in two voices, as in \sig{T}.}
\cn{88}{A}{c\sh′ (major final chord) is in \sig{T}; at bar 87 the sharp is
  \sig{P}’s.}
\end{apparatus}

\section*{Underlay}

\begin{apparatus}
\cn{3–12}{T}{Cantus firmus. \la{Nunc} covers the chant’s opening neume
  (f–d–g–f–e), \la{sci-o} its g and a; \la{-re} falls on the cadence note
  c′ of bar 9, and the clause is repeated.}
\cn{13–56}{C}{Cantus firmus. Syllables follow the chant, e.g. \la{om-} on
  g′–a′ and \la{-ni} on d′ (bars 41–42), and three syllables of
  \la{exspectatione} on the repeated g′ of bars 42–43. Where the chant and
  rule 3 conflict, the rule decides (\la{-mi-} of \la{Dominus}, bar 16).}
\cn{26–29}{C}{The chant’s melisma on \la{erípuit} falls on \la{-it}, not
  \la{-pu-}; the Cantus follows it, with \la{-it} on the c″ of bar 27.}
\cn{}{}{Elsewhere, where a free voice had a melisma of more than four
  semibreves, the clause is repeated instead, as in Wacław’s prints (e.g.
  \voice{T}, \la{exspectatione}, bars 44–48; \voice{B}, \la{eripuit me},
  bars 25–30).}
\cn{44–45}{C}{The stressed \la{-o-} of \la{exspectatione} takes the
  semibreve a′; the chant’s c″ at bar 44 carries \la{-ti-}.}
\cn{50–56}{all}{The stressed \la{-o-} of \la{Iudaeórum} falls on a strong
  minim or a high note in every voice (e.g. \voice{C}, the semibreve a′ at
  bar 53).}
\cn{63–71}{B}{The Bassus recites the psalm tone on c; its mediant shape
  (d c c, c–a, c) carries \la{-ri-tu-i San-cto} syllabically.}
\end{apparatus}

